# Copy this file to .env at the repository root. Both the web app and the
# Python pipelines read it; real environment variables take precedence.
# Never commit .env.

# --- Shared -------------------------------------------------------------------

# PostgreSQL connection string. The default matches docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketing

# Bearer token for the REST API. Every non-GET request must send it, and the
# Python scripts (audit, briefs, opportunities, digest) use it to write results.
# Writes are refused while this is empty. Use a long random value outside local
# development, for example: openssl rand -hex 32
API_TOKEN=dev-token-change-me

# The tracked site and brand. Shown in the UI and used to recognise the brand
# in search queries and AI answers.
SITE_URL=https://www.northpeak.example
BRAND_NAME=Northpeak Outfitters

# --- Web app ------------------------------------------------------------------

# Set to true to require the bearer token on GET requests to the API as well.
API_REQUIRE_TOKEN_FOR_READS=false

# --- Pipelines: general ----------------------------------------------------------

# Where the scripts reach the web app's REST API.
API_BASE_URL=http://localhost:3000

# console (key=value lines) or json (one object per line, for log collectors).
LOG_FORMAT=console
LOG_LEVEL=INFO

# Directory of SQL migrations. Only needed when the package is installed
# somewhere other than this repository layout.
# MIGRATIONS_DIR=/path/to/db/migrations

# Other names the brand goes by in AI answers, comma-separated.
BRAND_ALIASES=Northpeak
# Regular expression that marks a search query as a brand query.
BRAND_QUERY_PATTERN=north\s*-?\s*peak|northpeek|nrthpeak
# Competitors tracked in AI answers and domain metrics, as Name=domain pairs.
COMPETITORS=Summit & Co=summitandco.example,TrailForge=trailforge.example,Alpenway=alpenway.example

# --- Pipelines: demo mode ----------------------------------------------------------

# Seed for the synthetic dataset. The same seed and anchor date always produce
# the same rows.
DEMO_SEED=20260101
# Last day of demo data is the day before this date. Defaults to today.
# DEMO_ANCHOR_DATE=2026-06-01

# --- Pipelines: live sources -----------------------------------------------------
# Install the Google client libraries first: pip install -e "pipelines[google]"

# GA4 Data API: numeric property ID and a service-account key file with the
# Viewer role on the property.
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Search Console property, exactly as it appears in Search Console, for example
# sc-domain:example.com or https://www.example.com/. The same service account
# needs read access to it.
GSC_SITE_URL=

# SEO-tool exports: the directory to drop keyword CSVs (and an optional
# domain-metrics.csv) into. Defaults to pipelines/exports in this repository.
# SEO_EXPORT_DIR=/path/to/exports
# Column mapping for keyword exports: semrush, ahrefs, or a path to a JSON mapping.
SEO_CSV_PRESET=semrush

# Answer engines asked by the live AI-visibility pipeline. An engine is used
# when both its key and model are set. ChatGPT, Perplexity and Gemini are
# called through their OpenAI-compatible chat endpoints.
AI_ENGINE_CHATGPT_API_KEY=
AI_ENGINE_CHATGPT_MODEL=
# AI_ENGINE_CHATGPT_BASE_URL=https://api.openai.com/v1
AI_ENGINE_PERPLEXITY_API_KEY=
AI_ENGINE_PERPLEXITY_MODEL=
# AI_ENGINE_PERPLEXITY_BASE_URL=https://api.perplexity.ai
AI_ENGINE_GEMINI_API_KEY=
AI_ENGINE_GEMINI_MODEL=
# AI_ENGINE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_ENGINE_CLAUDE_API_KEY=
AI_ENGINE_CLAUDE_MODEL=

# --- Pipelines: LLM for summaries, briefs and the digest -------------------------

# offline (rule-based output, no network), anthropic, or openai (any
# OpenAI-compatible endpoint).
LLM_PROVIDER=offline
LLM_TIMEOUT_SECONDS=60

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Where `map digest` writes its Markdown file. Defaults to pipelines/reports
# in this repository.
# DIGEST_OUTPUT_DIR=/path/to/reports

# --- Tests ------------------------------------------------------------------------

# These two are read from the shell environment only, not from .env.

# A separate, disposable database for the integration tests on both sides. The
# tests recreate its schema, so never point this at real data. Integration
# tests are skipped when it is unset.
#   export TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketing_test

# Base URL for the Playwright browser tests (default http://localhost:3000).
#   export E2E_BASE_URL=http://localhost:3000
